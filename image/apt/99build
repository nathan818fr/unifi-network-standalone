Acquire::Retries "5";
Acquire::http::Timeout "60";
Acquire::https::Timeout "60";
APT::Update::Error-Mode "any";
// The base image has no openssl package, so apt doesn't find this file by itself.
Acquire::https::CAInfo "/etc/ssl/certs/ca-certificates.crt";
// A snapshot's lists are past their validity date: the pin takes over from that check.
Acquire::Check-Valid-Until "false";
